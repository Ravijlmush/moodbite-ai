# MoodBite AI — Root Environment Configuration Example
# Copy to .env (or backend/.env) and fill in an API key when ready.
# When no API key is set and LLM_PROVIDER=auto, MoodBite automatically runs
# in deterministic offline mode so every feature works out of the box.

# LLM Provider: auto | openrouter | openai | gemini | ollama | offline
LLM_PROVIDER=auto

# OpenRouter (optional — paste your key here)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MoodBite AI

# OpenAI (optional — add later)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (optional — add later)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Strict timeout per LLM extraction call (Spec 07: fallback if > 2.5s)
LLM_TIMEOUT_SECS=2.5

# Embeddings: local_semantic | openai
EMBEDDING_PROVIDER=local_semantic

# Optional Infrastructure (falls back gracefully to JSON catalog + in-memory TTL store)
DATABASE_URL=
REDIS_URL=

# Daily request quota cap (protects your OpenRouter / LLM API budget)
DAILY_REQUEST_LIMIT=20

# Frontend API target
NEXT_PUBLIC_API_URL=http://localhost:8000
