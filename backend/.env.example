# MoodBite AI Backend Environment Example
LLM_PROVIDER=auto

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=MoodBite AI

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LLM_TIMEOUT_SECS=2.5
EMBEDDING_PROVIDER=local_semantic

DATABASE_URL=
REDIS_URL=
DAILY_REQUEST_LIMIT=20
RATE_LIMIT_PERSIST_PATH=data/daily_usage.json
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Swiggy Food MCP Configuration (Spec 10)
SWIGGY_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8000/auth/swiggy/callback
SWIGGY_FRONTEND_REDIRECT_URI=http://localhost:3000
SWIGGY_CLIENT_ID=
SWIGGY_MCP_TIMEOUT_SECS=3.0
DEMO_FALLBACK_MODE=false
