  "components": {
    "schemas": {
      "ActiveFilters": {
        "properties": {
          "dietary_type": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "veg",
                  "jain",
                  "vegan",
                  "eggetarian",
                  "halal",
                  "non_veg",
                  "any"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Dietary Type"
          },
          "max_budget_inr": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5000.0,
                "minimum": 50.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Budget Inr"
          }
        },
        "type": "object",
        "title": "ActiveFilters"
      },
      "AddComboToSwiggyCartRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "restaurant_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Restaurant Id"
          },
          "item_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Item Ids"
          },
          "combo_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Combo Id"
          },
          "combo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComboRecommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "address_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Id"
          },
          "swiggy_access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Swiggy Access Token"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "restaurant_id",
          "item_ids"
        ],
        "title": "AddComboToSwiggyCartRequest"
      },
      "AddToCartRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "combo_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Combo Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          },
          "combo": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComboRecommendation"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "combo_id"
        ],
        "title": "AddToCartRequest"
      },
      "CartEntry": {
        "properties": {
          "combo": {
            "$ref": "#/components/schemas/ComboRecommendation"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity",
            "default": 1
          },
          "line_total_inr": {
            "type": "integer",
            "title": "Line Total Inr"
          }
        },
        "type": "object",
        "required": [
          "combo",
          "line_total_inr"
        ],
        "title": "CartEntry"
      },
      "CartResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/CartEntry"
            },
            "type": "array",
            "title": "Items"
          },
          "total_items": {
            "type": "integer",
            "title": "Total Items",
            "default": 0
          },
          "total_price_inr": {
            "type": "integer",
            "title": "Total Price Inr",
            "default": 0
          },
          "swiggy_synced": {
            "type": "boolean",
            "title": "Swiggy Synced",
            "default": false
          },
          "swiggy_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Swiggy Message"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "CartResponse"
      },
      "CatalogStatsResponse": {
        "properties": {
          "total_restaurants": {
            "type": "integer",
            "title": "Total Restaurants"
          },
          "open_restaurants": {
            "type": "integer",
            "title": "Open Restaurants"
          },
          "total_items": {
            "type": "integer",
            "title": "Total Items"
          },
          "main_dishes": {
            "type": "integer",
            "title": "Main Dishes"
          },
          "boosters": {
            "type": "integer",
            "title": "Boosters"
          },
          "veg_items": {
            "type": "integer",
            "title": "Veg Items"
          },
          "jain_items": {
            "type": "integer",
            "title": "Jain Items"
          },
          "vegan_items": {
            "type": "integer",
            "title": "Vegan Items"
          },
          "non_veg_items": {
            "type": "integer",
            "title": "Non Veg Items"
          },
          "egg_items": {
            "type": "integer",
            "title": "Egg Items"
          }
        },
        "type": "object",
        "required": [
          "total_restaurants",
          "open_restaurants",
          "total_items",
          "main_dishes",
          "boosters",
          "veg_items",
          "jain_items",
          "vegan_items",
          "non_veg_items",
          "egg_items"
        ],
        "title": "CatalogStatsResponse"
      },
      "ChatRefineRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
            "default": "usr_guest"
          },
          "chip": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Chip"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "active_filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActiveFilters"
              },
              {
                "type": "null"
              }
            ]
          },
          "swiggy_access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Swiggy Access Token"
          },
          "address_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Id"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "chip"
        ],
        "title": "ChatRefineRequest"
      },
      "ChatTurnRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Session Id"
          },
          "user_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "User Id",
            "default": "usr_guest"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "active_filters": {
            "$ref": "#/components/schemas/ActiveFilters"
          },
          "swiggy_access_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Swiggy Access Token"
          },
          "address_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address Id"
          }
        },
        "type": "object",
        "required": [
          "session_id"
        ],
        "title": "ChatTurnRequest"
      },
      "ChatTurnResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "turn_count": {
            "type": "integer",
            "title": "Turn Count"
          },
          "action": {
            "type": "string",
            "enum": [
              "ask_followup",
              "recommend_combos",
              "crisis_support"
            ],
            "title": "Action"
          },
          "agent_message": {
            "type": "string",
            "title": "Agent Message"
          },
          "user_context": {
            "$ref": "#/components/schemas/UserContextSummary"
          },
          "full_context": {
            "$ref": "#/components/schemas/UserContext"
          },
          "recommendations": {
            "items": {
              "$ref": "#/components/schemas/ComboRecommendation"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "quick_reply_pills": {
            "items": {
